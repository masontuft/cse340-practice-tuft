<%- include('partials/header') %>
<!-- Data Structure
 id: section.id,
        time: section.time,
        room: section.room,
        courseCode: section.course_code,
        courseName: section.course_name,
        description: section.description,
        creditHours: section.credit_hours,
        professor: `${section.first_name} ${section.last_name}`,
        professorSlug: section.faculty_slug,
        professorTitle: section.faculty_title,
        department: section.department_name,
        departmentCode: section.department_code
         -->
<main>
    <h1><%= course.slug %>: <%= course.name %></h1>

    <p><strong>Department:</strong> <%= course.department %></p>
    <p><strong>Credits:</strong> <%= course.creditHours %></p>
    <p><%= course.description %></p>

    <h2>Sections</h2>

    <form method="GET" action="/catalog/<%= course.slug %>">
        <label for="sort">Sort by:</label>

        <select id="sort" name="sort">
            <option value="time" <%= currentSort === 'time' ? 'selected' : '' %>>
                Original order
            </option>
            <option value="professor" <%= currentSort === 'professor' ? 'selected' : '' %>>
                Professor
            </option>
            <option value="room" <%= currentSort === 'room' ? 'selected' : '' %>>
                Room
            </option>
        </select>

        <button type="submit">Sort</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Time</th>
                <th>Room</th>
                <th>Professor</th>
            </tr>
        </thead>
        <tbody>
            <% sections.forEach(section => { %>
                <tr>
                    <td><%= section.time %></td>
                    <td><%= section.room %></td>
                    <td><%= section.professor %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <p>
        <a href="/catalog">Back to catalog</a>
    </p>
</main>

<%- include('partials/footer') %>