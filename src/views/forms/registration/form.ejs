<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <% if (errors && errors.length > 0) { %>
        <div class="error-summary" role="alert">
            <h2>Please correct these errors:</h2>
            <ul>
                <% errors.forEach(error => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>
    <p>
        Register for a new account by providing your information below. All fields are required and passwords must meet security requirements.
    </p>

    <form method="POST" action="/register" class="registration-form">
        <!-- Name field -->
        <div class="form-group">
             <label for="name">Name</label>
             <input type="text" id="name" name="name" minlength="2" required placeholder="Enter your full name">
        </div>

        <!-- Email field -->
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="Enter your email address">
        </div>

        <!-- Email confirmation field -->
        <div class="form-group">
            <label for="emailConfirm">Confirm Email</label>
            <input type="email" id="emailConfirm" name="emailConfirm" required placeholder="Confirm your email address">
        </div>

        <!-- Password field -->
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" required placeholder="Enter a secure password" pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*">
        </div>
        
        <!-- TODO: Add a div with class="help-text" explaining requirements -->
        <div class="help-text">
            <p class="registration-help-text">
                HINT: Must be at least 8 characters with a number and special character.
            </p>
        </div>

        <!-- Password confirmation field -->
         <div class="form-group">
            <label for="passwordConfirm">Confirm Password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" minlength="8" required placeholder="Confirm your password">
        </div>
         <button type="submit">Create Account</button>
    </form>
</main>
<%- include('../../partials/footer') %>